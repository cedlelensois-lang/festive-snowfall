msgstr "Programmation %d : date invalide, la date par défaut a été utilisée."
#, php-format

msgid "Schedule %d: the end date is before the start date, it will never be displayed."
msgstr "Programmation %d : la date de fin est antérieure à la date de début, elle ne s'affichera jamais."

