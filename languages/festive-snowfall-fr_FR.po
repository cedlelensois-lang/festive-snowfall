msgid "0 disables snow on that device type."
msgstr "0 désactive la neige sur ce type d'appareil."

msgid "1 = very slow, 10 = very fast."
msgstr "1 = très lent, 10 = très rapide."

msgid "Add a schedule"
msgstr "Ajouter une programmation"

msgid "Asterisk"
msgstr "Astérisque"

msgid "Banner position"
msgstr "Position de la bannière"

msgid "Banner style"
msgstr "Style de bannière"

msgid "Both days are included. The site time zone (Settings > General) is used."
msgstr "Les deux jours sont inclus. Le fuseau horaire du site (Réglages > Général) est utilisé."

msgid "CSS selector"
msgstr "Sélecteur CSS"

msgid "Candy canes"
msgstr "Sucres d'orge"

